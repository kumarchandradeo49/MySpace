<%- include('partials/header'); -%>

<div id="post-container">
  <h1 class="post-h1"><%= title %></h1>
  <p class="post-desc"><%= content %></p>

  <%
    let ext = "";
    if (typeof file === "string" && file.includes(".")) {
      ext = file.split('.').pop().toLowerCase();
    }

    const encodedFile = encodeURIComponent(file);
    const flDownloadLink = file.replace('/upload/', '/upload/fl_attachment/');
  %>

  <div class="file-preview mt-4">
    <% if (file) { %>
      <% if (ext === 'pdf') { %>
        <iframe 
          src="https://docs.google.com/gview?url=<%= encodedFile %>&embedded=true"
          width="100%" 
          height="600px" 
          frameborder="0"
        ></iframe>

      <% } else if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif'].includes(ext)) { %>
        <img src="<%= file %>" alt="Image" class="preview-img img-fluid" />

      <% } else if (['mp4', 'webm', 'ogg'].includes(ext)) { %>
        <div class="ratio ratio-16x9">
          <video controls>
            <source src="<%= file %>" type="video/<%= ext %>" />
            Your browser does not support the video tag.
          </video>
        </div>

      <% } else { %>
        <p>Preview not available. You can download the file below.</p>
      <% } %>

    <% } else { %>
      <p>No file uploaded for this post.</p>
    <% } %>
  </div>

  <% if (file) { %>
    <a
      href="<%= flDownloadLink %>"
      class="btn btn-success download-btn mt-3"
    >
      <i class="bi bi-download"></i> Download
    </a>
  <% } %>

  <% if (user) { %>
    <form
      class="edit d-inline-block mt-3"
      action="/posts/<%= postId %>/edit"
      method="get"
    >
      <button class="btn btn-primary edit-btn" type="submit">
        <i class="bi bi-pencil-square"></i> Edit
      </button>
    </form>

    <form
      class="delete d-inline-block mt-3"
      action="/posts/<%= postId %>/delete"
      method="POST"
    >
      <button
        class="btn btn-danger delete-btn"
        type="submit"
        onclick="return confirm('Are you sure you want to delete this post?')"
      >
        <i class="bi bi-trash"></i> Delete
      </button>
    </form>
  <% } %>
</div>

<%- include('partials/footer'); -%>






   
